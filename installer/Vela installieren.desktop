[Desktop Entry]
Type=Application
Version=1.0
Name=Vela installieren
Name[de]=Vela installieren
Comment=Installiert Vela Secure auf diesem Raspberry Pi
Icon=system-software-install
Exec=bash -c 'f=""; for c in "$(dirname "$0")"/* /media/*/*/* /media/*/* /run/media/*/*/* /mnt/*/*; do if [ -f "$c" ] && head -c 300000 "$c" 2>/dev/null | grep -aqE "^__VELA_PAYLOAD_(IMAGE|SOURCE)__$"; then f="$c"; break; fi; done; if [ -z "$f" ]; then echo; echo "  Der Vela-Installer wurde auf dem USB-Stick nicht gefunden."; echo "  Auf dem Stick liegen gerade diese Dateien:"; echo; ls -la /media/*/*/ 2>/dev/null; echo; read -r -p "  Enter zum Schliessen ..." x; exit 1; fi; echo "  Installer gefunden: $f"; exec bash "$f" --gui' %k
Terminal=true
Categories=System;
